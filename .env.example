# Frontend Deployment Settings (Vercel)
# Set to your Render backend API URL in Vercel environment settings (e.g. https://sentimentscope-backend.onrender.com)
VITE_API_URL=

# Flask Application Settings
FLASK_ENV=production
FLASK_APP=backend/app.py
HOST=0.0.0.0
PORT=5000
SECRET_KEY=change_this_to_a_secure_random_secret_key

# Machine Learning Settings
SENTIMENT_MODEL_PATH=backend/ml/models/sentiment_model.pkl

# Upload Configurations
UPLOAD_FOLDER=backend/uploads
MAX_UPLOAD_SIZE=10485760 # 10 MB in bytes

# Logging Settings
LOG_LEVEL=INFO

