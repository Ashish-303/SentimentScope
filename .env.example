# SentimentScope Environment Configuration Template
# Copy this file to .env and configure appropriate values for deployment.

# Flask Application Settings
FLASK_ENV=production
FLASK_APP=backend/app.py
HOST=0.0.0.0
PORT=5000
SECRET_KEY=dev_secret_key_change_in_production

# Machine Learning Settings
SENTIMENT_MODEL_PATH=backend/ml/models/sentiment_model.pkl

# Upload Configurations
UPLOAD_FOLDER=backend/uploads
MAX_UPLOAD_SIZE=10485760 # 10 MB in bytes

# Logging & Diagnostic Settings
LOG_LEVEL=INFO
